# Copie para .env e preencha (Supabase > Project Settings > API).
# Use SOMENTE a chave pública (anon/publishable). Nunca a service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# (Opcional) URL pública do site para as tags Open Graph.
# Na Vercel, sem esta variável, é usado o domínio de produção do projeto.
VITE_SITE_URL=
