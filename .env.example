# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# (Project Settings > API). Use SOMENTE a chave anon/publishable no front-end.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# (Opcional) URL pública do site, usada nas tags Open Graph.
# Na Vercel, se não for definida, usa automaticamente o domínio de produção.
# VITE_SITE_URL=https://seu-dominio.com.br
